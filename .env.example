# Copy to .env for local use. Never commit .env.
# Which config file to use (default: config.yaml). On Kaggle: config_kaggle.yaml
G2_CONFIG=config.yaml
# Ollama server(s). The second one is used only on Kaggle's second GPU.
OLLAMA_HOST=http://localhost:11434
OLLAMA_HOST_2=http://localhost:11435
# GitHub token: NEVER put it here. On Kaggle it is a Kaggle Secret named GITHUB_TOKEN.
